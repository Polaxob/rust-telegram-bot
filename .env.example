# Telegram Bot Token — получи у @BotFather в Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Steam Web API Key — получить на https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# BattleMetrics API Key — получить на https://battlemetrics.com/developers
BM_API_KEY=your_battlemetrics_api_key_here

# RCON — чтобы бот показывал ники на ТВОЁМ сервере, когда UDP с хостинга
# заблокирован. Впиши ip:port своего игрового сервера и пароль из server.cfg
# (RCON_SERVER должен точно совпадать с адресом в /players).
RCON_SERVER=80.242.59.57:20010
RCON_PORT=28016
RCON_PASSWORD=your_rcon_password_here
