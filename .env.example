# Telegram Bot Token — получи у @BotFather в Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Steam Web API Key — получить на https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# BattleMetrics API Key — получить на https://battlemetrics.com/developers
BM_API_KEY=your_battlemetrics_api_key_here
